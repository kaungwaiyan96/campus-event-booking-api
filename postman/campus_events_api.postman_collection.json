    {
      "name": "Events",
      "item": [
        {
          "name": "Create ongoing test event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-user-id",
                "value": "{{organizerId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/events",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Member 3 Postman {{runId}}\",\n  \"description\": \"Disposable integration fixture\",\n  \"venueName\": \"{{testLocation}}\",\n  \"venueAddress\": \"Building A\",\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\",\n  \"capacity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "pm.collectionVariables.set('runId', String(now));",
                  "pm.collectionVariables.set('testLocation', 'Member3-' + now);",
                  "pm.collectionVariables.set('startTime', new Date(now - 60000).toISOString());",
                  "pm.collectionVariables.set('endTime', new Date(now + 3600000).toISOString());",
                  "pm.collectionVariables.set('filterDate', new Date(now - 60000).toISOString().slice(0,10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Created', () => pm.expect(body.success).to.eql(true));",
                  "pm.collectionVariables.set('eventId', body.data.id);"
                ]
              }
            }
          ],
          "response": []
        },
