                  "pm.test('Success envelope', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('Public weather integration is included', () => {",
                  "  pm.expect(body.data.weather.source).to.eql('open-meteo');",
                  "  pm.expect(body.data.weather.available).to.be.a('boolean');",
                  "  pm.expect(body.data.weather).to.have.property('temperatureC');",
